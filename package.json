{
  "name": "deprevoz-info",
  "version": "1.0.0",
  "scripts": {
    "start:web": "ng serve --configuration=web",
    "start:extension": "web-ext run --browser-console --source-dir ./dist/deprevoz-info/browser/",
    "build:extension": "ng build --configuration=extension",
    "lint:extension": "web-ext lint --source-dir ./dist/deprevoz-info/browser/",
    "assembly:extension": "npm run copy:license; npm run build:extension",
    "copy:license": "cp ./LICENSE.md ./assets"
  },
  "private": true,
  "author": {
    "name": "Diana Kozachenko",
    "email": "kozachenkodiana03@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@angular/common": "20.2.0",
    "@angular/compiler": "20.2.0",
    "@angular/core": "20.2.0",
    "@angular/forms": "20.2.0",
    "@angular/platform-browser": "20.2.0",
    "@angular/router": "20.2.0",
    "rxjs": "7.8.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "20.2.1",
    "@angular/cli": "20.2.1",
    "@angular/compiler-cli": "20.2.0",
    "typescript": "5.9.2",
    "web-ext": "9.0.0"
  }
}
